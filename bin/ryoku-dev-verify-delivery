#!/usr/bin/env bash
# verify that what a dev box runs actually reaches an installed box.
#
# a per-app config can land in the repo while no package/installer/deploy path
# ships it, so `ryoku update` (materialize) never lays it. this catches it.
#
#   ryoku-dev-verify-delivery            run every check (exit 1 on a hard gap)
#   ryoku-dev-verify-delivery --quiet    same, only print problems
#
# see docs/updates.md for the delivery contract this enforces.
set -euo pipefail

quiet=0
[[ ${1:-} == --quiet ]] && quiet=1
say() { (( quiet )) || printf '%s\n' "$*"; }

repo="$(git rev-parse --show-toplevel)"
cd "$repo"

# delivery paths: the package base config, the installer's one-time seeds, and
sources=()
for src in release/rpm/payload/*.sh release/rpm/*.spec installation/fedora/provision-target.py ryoku/shell/deploy.sh; do
	[[ -f $src ]] && sources+=("$src")
done

# delivered = the file, or any ancestor dir up to apps/, is named by a delivery
# path. a wholesale `cp -a apps/foo/.` ships every file under foo, so a match on
# any ancestor counts. the "apps/..." suffix matches both the package paths
delivered() {
	local p="apps/${1#*/apps/}"
	while :; do
		grep -Fq -e "$p" "${sources[@]}" && return 0
		[[ $p == apps/*/* ]] || break
		p="$(dirname "$p")"
	done
	return 1
}

fail=0

# config orphans. every dotfile under ryoku/apps that ends up in a user's
# home must be laid by a delivery path. skip a GUI app's quickshell tree, bin
# helpers, .desktop handlers, docs, Go build sources/artifacts, and a Go
# backend's testdata fixtures (test-only, never shipped): those ship by their
# own package rules, not as materialized config.
while IFS= read -r f; do
	delivered "$f" || {
		echo "delivery: ${f#"$repo"/} is in the repo but no package/installer/deploy ships it (users never get it)" >&2
		fail=1
	}
done < <(find ryoku/apps -type f \
	-not -path '*/quickshell/*' -not -path '*/bin/*' -not -path '*/backend/testdata/*' \
	-not -name '*.desktop' -not -name '*.md' -not -name 'README*' \
	-not -name '*.go' -not -name 'go.mod' -not -name 'go.sum' \
	-not -name '*.cpp' -not -name '*.h' -not -name '*.qml' -not -name 'CMakeLists.txt' ! -executable)

(( fail )) || say "delivery: every ryoku/apps config is shipped by a package, installer, or deploy path"

# 1b. the translation catalog. Every language in the one table must have a
# catalog file, and the catalog directory must be shipped: a language listed in
# the Hub's picker with no file behind it silently serves English, and a catalog
# no package installs leaves every surface English on an installed box while
# looking translated in a checkout.
langs=ryoku/i18n/langs.json
if [[ -f $langs ]]; then
	missing=()
	while IFS= read -r code; do
		[[ $code == en ]] && continue          # English keys are the strings
		[[ -f ryoku/i18n/catalog/$code.json ]] || missing+=("$code")
	done < <(python3 ryoku/i18n/tools/sync.py langs)
	if ((${#missing[@]})); then
		echo "delivery: langs.json lists ${missing[*]} with no ryoku/i18n/catalog/<code>.json (the Hub offers a language that serves English)" >&2
		fail=1
	else
		say "delivery: every language in langs.json has a catalog"
	fi
	if grep -Fq 'usr/share/ryoku/i18n' "${sources[@]}"; then
		say "delivery: the translation catalog is installed to /usr/share/ryoku/i18n"
	else
		echo "delivery: no package installs ryoku/i18n/catalog to /usr/share/ryoku/i18n (every surface would read English on an installed box)" >&2
		fail=1
	fi
fi

# 1c. QML modules. A shipped surface that imports a module no Ryoku package
# depends on loads on a dev box that happens to carry it and fails whole on
# every other one: Shima imported KDE's Kirigami, which only arrives with
# unrelated KDE apps, so the style could not load for most users. Each import
# root must be in-tree or come from a package ryoku-desktop (or a Ryoku package
# it requires) depends on. `qs` is Quickshell's name for the running config's
# own root, so it is in-tree too.
declare -A qml_module_pkg=(
	[Qt]=qt6-qtdeclarative [QtQuick]=qt6-qtdeclarative [QtQml]=qt6-qtdeclarative
	[QtCore]=qt6-qtdeclarative [QtMultimedia]=qt6-qtmultimedia
	[Qt5Compat]=qt6-qt5compat [Quickshell]=quickshell
	[org.kde.syntaxhighlighting]=kf6-syntax-highlighting
)
qml_in_tree=(Ryoku inir shell stage RashinApp qs)
spec_requires() { sed -nE 's/^Requires:[[:space:]]+([^[:space:]]+).*/\1/p' "release/rpm/$1.spec"; }
desktop_requires=" $(spec_requires ryoku-desktop | tr '\n' ' ')"
for dep in $desktop_requires; do
	[[ -f release/rpm/$dep.spec ]] && desktop_requires+=" $(spec_requires "$dep" | tr '\n' ' ')"
done
qml_fail=0
while IFS=: read -r file module; do
	root=${module%%.*}
	[[ " ${qml_in_tree[*]} " == *" $root "* ]] && continue
	pkg=${qml_module_pkg[$module]:-${qml_module_pkg[$root]:-}}
	if [[ -z $pkg ]]; then
		echo "delivery: $file imports $module, which no Ryoku package provides (add its package to ryoku-desktop's Requires and to this table, or drop the import)" >&2
		qml_fail=1
	elif [[ "$desktop_requires " != *" $pkg "* ]]; then
		echo "delivery: $file imports $module from $pkg, which ryoku-desktop does not require" >&2
		qml_fail=1
	fi
done < <(git ls-files -z 'ryoku/*.qml' ':!ryoku/lockscreen/qylock/*' |
	xargs -0 grep -aHoE '^import [A-Za-z][A-Za-z0-9.]*( |$)' | grep -v ',' |
	sed -E 's/:import /:/; s/ $//' | sort -u)
if (( qml_fail )); then
	fail=1
else
	say "delivery: every QML module the desktop imports is shipped or a ryoku-desktop dependency"
fi

exit "$fail"
