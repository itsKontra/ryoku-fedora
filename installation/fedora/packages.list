# Fedora 44 Ryoku ISO Package Closure
#
# Hermetic package payload for offline installation media.
# Dependencies are solved during compose against an empty installroot.

[base]
# Fedora 44 Minimal Environment
rootfiles
glibc
glibc-all-langpacks
systemd
systemd-udev
systemd-resolved
systemd-networkd
util-linux
shadow-utils
sudo
authselect
selinux-policy-targeted
policycoreutils
policycoreutils-python-utils
btrfs-progs
dosfstools
e2fsprogs
cryptsetup
kbd
kbd-misc
tzdata
dnf5
rpm
tar
gzip
iproute
iputils
chrony
xdg-user-dirs
xdg-utils
pciutils
desktop-file-utils
adwaita-icon-theme

[kernel]
# Standard Fedora kernel and dracut
kernel
kernel-core
kernel-modules
dracut
dracut-config-generic
kernel-devel
dkms

[bootloader]
# UEFI bootloader
grub2-efi-x64
grub2-common
shim-x64
efibootmgr
plymouth

[drivers]
# Open graphics drivers and hardware firmware
mesa-dri-drivers
mesa-vulkan-drivers
vulkan-loader
xorg-x11-server-Xwayland
libva-utils
linux-firmware
amd-ucode-firmware
microcode_ctl
wireless-regdb

[utilities]
# Core utilities and interactive tools
chromium
tmux
neovim
vim-enhanced
bat
lua
python3
alacritty
fish
fzf
less
grep
ripgrep
nano
zsh
bash
firefox
git
bash-completion
fd-find
eza
btop
lazygit
yazi
zoxide
gh

[services]
# Base system services
firewalld
NetworkManager
NetworkManager-wifi
bluez
pipewire
wireplumber
sddm
pipewire-utils
pipewire-pulseaudio
pipewire-alsa
alsa-utils
wpa_supplicant
iwd

[multimedia]
# Published Ryoku components require Fedora FFmpeg
ffmpeg-free
rpmfusion-free-release
rpmfusion-nonfree-release
gstreamer1-plugins-base
gstreamer1-plugins-good
gstreamer1-plugins-bad-free
gstreamer1-plugins-ugly-free
gstreamer1-plugin-libav

[desktop]
# Ryoku desktop packages and Wayland environment
ryoku-desktop
ryoku-desktop-niri
niri
xwayland-satellite
quickshell
nautilus
nautilus-python
flatpak
libnotify
fuzzel
gpu-screen-recorder
songrec
fira-code-fonts
source-foundry-hack-fonts
gamemode
gamescope
mangohud
edk2-ovmf
qemu-system-x86
virglrenderer
moby-engine
