#!/usr/bin/env python3
#
# Asks the Anaconda add-on's enrollment screen, loaded against stand-ins for
# Anaconda's classes, whether it would appear for a handoff directory (what
# post/stage leaves in /run/ryoku-iso) and what it would say. Prints "hidden",
# or "shown" followed by the screen's text. check.sh holds the expectations;
# tests/vm-install.sh and a real install exercise the real Anaconda.
#
#   enrollment-screen <addons dir> <handoff dir>
import importlib
import pathlib
import sys
import tempfile

STUBS = {
    "pyanaconda/core/constants.py": 'ANACONDA_ENVIRON = "anaconda"\n',
    "pyanaconda/core/i18n.py": "def C_(context, text):\n    return text\n",
    "pyanaconda/ui/gui/hubs/summary.py": "class SummaryHub:\n    pass\n",
    "pyanaconda/ui/gui/spokes/__init__.py": (
        "class StandaloneSpoke:\n"
        "    @classmethod\n"
        "    def should_run(cls, environment, data):\n"
        '        return environment == "anaconda"\n'
    ),
}

addons, handoff = sys.argv[1:3]
with tempfile.TemporaryDirectory() as stubs:
    for path, source in STUBS.items():
        target = pathlib.Path(stubs, path)
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(source)
    sys.path[:0] = [stubs, addons]
    sys.dont_write_bytecode = True
    screen = importlib.import_module("dev_ryoku_iso.gui.spokes.enrollment")

screen.HANDOFF = handoff
spoke = screen.EnrollmentSpoke
if spoke.should_run("anaconda", None):
    print("shown")
    print(screen.queued_notice(handoff))
else:
    print("hidden")
