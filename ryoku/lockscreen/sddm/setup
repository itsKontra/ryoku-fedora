#!/usr/bin/env bash
#
# sddm/setup: wire SDDM as the graphical login manager at install time.
#
# runs on the target (typically from the install backend, in the chroot or
# via sudo). the plumbing that makes a fresh box boot into the SDDM greeter
# instead of a bare tty:
#
#   1. enable sddm.service
#   2. default systemd target = graphical
#   3. wire /etc/pam.d/sddm for the shipped keyring mode through
#      `ryoku keyring apply-pam`: unlock-on-login, or never-ask under
#      SDDM autologin, where there is no login password for PAM to reuse.
#   4. make sure the configured compositor's wayland session exists so SDDM can launch it
#
# the greeter THEME itself is installed by install-qylock. this script only
# does the SDDM service/session wiring; keep the two separate so a cosmetic
# theme failure never stops the login manager from coming up.
#
# usage:
#   setup                run the wiring
#   setup --dry-run      print the plan, change nothing
#   RYOKU_DRYRUN=1 setup  same, via the shared installer switch

set -euo pipefail

RYOKU_DRYRUN="${RYOKU_DRYRUN:-0}"
for arg in "$@"; do
  case "$arg" in
    --dry-run) RYOKU_DRYRUN=1 ;;
    -h | --help)
      sed -n '2,23p' "$0"
      exit 0
      ;;
    *)
      echo "setup: unknown argument: $arg" >&2
      exit 1
      ;;
  esac
done

run() {
  if [[ $RYOKU_DRYRUN == 1 ]]; then
    printf 'DRYRUN: %s\n' "$*"
    return 0
  fi
  "$@"
}

# root for system paths; sudo when we're not already root.
if (( EUID == 0 )); then
  PRIV=()
else
  PRIV=(sudo -n)
fi
priv() { run "${PRIV[@]}" "$@"; }

# write a root-owned system file, content on stdin (mirrors install-qylock).
write_root() {
  local path="$1" content
  content="$(cat)"
  if [[ $RYOKU_DRYRUN == 1 ]]; then
    printf 'DRYRUN: write (root) %s:\n%s\n' "$path" "$content"
    return 0
  fi
  printf '%s\n' "$content" | "${PRIV[@]}" tee "$path" >/dev/null
}

PAM_FILE="${RYOKU_PAM_FILE:-/etc/pam.d/sddm}"
SESSION_DIR="/usr/share/wayland-sessions"

# --- 1. enable the service ---------------------------------------------------
echo "  enabling sddm.service"
priv systemctl enable sddm.service

# --- 2. default to the graphical target --------------------------------------
# a minimal install or a chroot can leave default.target = multi-user.target =
# boots to a getty, SDDM never starts. the ryoku-desktop RPM's %post does not
# flip it (installation/fedora/provision-target.py does on a fresh install), so
# set it explicitly.
echo "  setting default target -> graphical.target"
priv systemctl set-default graphical.target

# --- 3. wire the login keyring into the SDDM PAM stack ----------------------
# The ryoku CLI owns this, so there is one implementation: `ryoku keyring
# status --json` detects SDDM autologin, and `ryoku keyring apply-pam`
# converges the stack (Fedora's stock lines for unlock-on-login, stripped for
# never-ask under autologin). The blank never-ask keyring is seeded later by
# `ryoku keyring init` in the user's session, never here: a root process must
# not create files in the user's home. Every installer path puts ryoku on PATH
# before this runs (the ryoku package, or deploy.sh into ~/.local/bin); a manual
# `sudo setup` from a dev checkout loses ~/.local/bin to sudo's secure_path,
# hence SUDO_USER.
ryoku_bin() {
  local home
  if command -v ryoku 2>/dev/null; then
    return 0
  fi
  if [[ -n ${SUDO_USER:-} ]]; then
    home=$(getent passwd "$SUDO_USER" | cut -d: -f6)
    if [[ -x $home/.local/bin/ryoku ]]; then
      printf '%s\n' "$home/.local/bin/ryoku"
      return 0
    fi
  fi
  return 1
}

keyring_warn() {
  echo "  WARNING: $1, so the login keyring may not unlock at sign-in;" >&2
  echo "  WARNING: fix it, then run: sudo ryoku keyring apply-pam <unlock-on-login|never-ask>" >&2
}

if [[ ! -f $PAM_FILE ]]; then
  echo "  note: $PAM_FILE not present yet; nothing to wire"
elif ! ryoku=$(ryoku_bin); then
  keyring_warn "the ryoku CLI is not installed"
elif ! keyring_status=$("$ryoku" keyring status --json); then
  keyring_warn "ryoku keyring status failed"
else
  keyring_mode=unlock-on-login
  if grep -Eq '"autologin":[[:space:]]*true' <<<"$keyring_status"; then
    keyring_mode=never-ask
  fi
  echo "  wiring the login keyring: ryoku keyring apply-pam $keyring_mode"
  if ! priv env RYOKU_PAM_FILE="$PAM_FILE" "$ryoku" keyring apply-pam "$keyring_mode"; then
    keyring_warn "ryoku keyring apply-pam $keyring_mode failed (see above)"
  fi
fi

# --- 4. make sure the configured compositor's wayland session exists ---------
# The compositor package normally ships its own entry; write a fallback only
# when it did not. The provider emits its own [Desktop Entry], so there is no
# compositor literal here; the file is named after that entry's Name.
body="$(ryoku wm session 2>/dev/null || true)"
id="$(printf '%s\n' "$body" | sed -n 's/^Name=//p' | head -n1 | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9-')"
if [[ -z $id ]]; then
  echo "  no compositor session provided; skipping session fallback"
else
  session_found=false
  shopt -s nullglob nocaseglob
  for f in "$SESSION_DIR/$id"*.desktop; do
    session_found=true
    echo "  $id session present: ${f##*/}"
    break
  done
  shopt -u nullglob nocaseglob

  if [[ $session_found == false ]]; then
    fallback="$SESSION_DIR/$id.desktop"
    echo "  writing fallback session -> $fallback"
    priv mkdir -p "$SESSION_DIR"
    if [[ $RYOKU_DRYRUN == 1 ]]; then
      printf 'DRYRUN: write (root) %s:\n%s\n' "$fallback" "$body"
    else
      printf '%s\n' "$body" | "${PRIV[@]}" tee "$fallback" >/dev/null
    fi
  fi
fi

# --- 5. run the greeter on Wayland, not X11 ----------------------------------
# SDDM's default X11 greeter is orphaned when a Wayland session starts:
# sddm-helper dies mid-teardown without reaping sddm-greeter-qt6, which
# lingers on a leftover Xorg and keeps drawing power (a video skin decodes a
# 1440p60 clip forever). Running the greeter on Wayland like the session lets
# SDDM own the VT and tear it down cleanly at login. weston --shell=kiosk is
# SDDM's default kiosk compositor (ryoku-desktop requires weston); the greeter
# connects to it as a separate Wayland client.
# The greeter has no session env, so XCURSOR_* is pinned to the shipped Bibata
# set (ryoku-cursors): without a theme Qt falls back to "default", and where that
# resolves to nothing the login screen has no visible pointer. Keep this body
# identical to sddmWaylandBody() in ryoku/cli/internal/doctor/doctor.go, which
# converges existing boxes onto it.
WAYLAND_CONF="/etc/sddm.conf.d/10-ryoku-wayland.conf"
GREETER_BIN="/usr/share/ryoku/lockscreen/ryoku-greeter"
# the wrapper runs weston at each output's top mode; plain weston (preferred) if
# the package has not landed it yet.
if [[ -x $GREETER_BIN ]]; then
  COMPOSITOR="$GREETER_BIN"
elif grep -qs 0x10de /sys/class/drm/card*/device/vendor; then
  # NVIDIA's KMS accepts the hardware cursor plane and never displays it under
  # weston (#184): the login pointer only shows through weston's software
  # cursor path (the pixman renderer). Mirrors the wrapper script for the
  # window before the package lands it.
  COMPOSITOR="weston --shell=kiosk --renderer=pixman"
else
  COMPOSITOR="weston --shell=kiosk"
fi
SESSION_WRAPPER="/usr/share/ryoku/lockscreen/ryoku-wayland-session"
# SessionCommand waits for the greeter (weston) to release the GPU before the
# session compositor probes KMS, so a hybrid-GPU laptop does not miss its iGPU
# and fall back to a black headless dGPU (issue #174). SDDM's own default until
# the wrapper lands. This body stays identical to sddmWaylandBody() (doctor.go).
if [[ -x $SESSION_WRAPPER ]]; then
  SESSION_CMD="$SESSION_WRAPPER"
else
  SESSION_CMD="/usr/share/sddm/scripts/wayland-session"
fi
echo "  greeter display server -> wayland ($WAYLAND_CONF)"
priv mkdir -p /etc/sddm.conf.d
write_root "$WAYLAND_CONF" <<EOF
[General]
DisplayServer=wayland
GreeterEnvironment=QT_QPA_PLATFORM=wayland,XCURSOR_THEME=Bibata-Modern-Ice,XCURSOR_SIZE=24,QML_XHR_ALLOW_FILE_READ=1

[Wayland]
CompositorCommand=$COMPOSITOR
SessionCommand=$SESSION_CMD
EOF

# --- 6. give the "default" cursor theme a real target ------------------------
# The greeter's Qt client and weston both fall back to the freedesktop cursor
# theme literally named "default" -- the greeter because SDDM's Wayland mode does
# not propagate a cursor theme, weston because none is set in its config. Ryoku
# ships no /usr/share/icons/default, so that fallback resolves to nothing and the
# login screen has no pointer at all at boot and after logout. Point "default" at
# the shipped Bibata set (ryoku-cursors). Only when the box has no default of its
# own; a user or another package that owns one is left untouched. Mirror this in
# reconcileGreeterCursor() (ryoku/cli/internal/doctor/doctor.go), which converges
# existing boxes.
DEFAULT_CURSOR_DIR="/usr/share/icons/default"
if [[ -e $DEFAULT_CURSOR_DIR/index.theme || -d $DEFAULT_CURSOR_DIR/cursors ]]; then
  echo "  default cursor theme already established; leaving it"
else
  echo "  default cursor theme -> Inherits=Bibata-Modern-Ice"
  priv mkdir -p "$DEFAULT_CURSOR_DIR"
  write_root "$DEFAULT_CURSOR_DIR/index.theme" <<'EOF'
[Icon Theme]
Name=Default
Comment=Ryoku default cursor
Inherits=Bibata-Modern-Ice
EOF
fi

echo "SDDM wiring complete."
