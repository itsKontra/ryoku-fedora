#!/bin/sh
exec 2>&1

# shellcheck disable=SC1091
. "${RYOKU_INIT_LIB:-/usr/lib/ryoku/runit}/wait-for"
load_session_env
BIN=${RYOKU_BIN_DIR:-/usr/bin}

_initial=${RYOKU_AI_USAGE_INITIAL:-45}
_period=${RYOKU_AI_USAGE_PERIOD:-300}


sleep "$_initial"
while :; do
	RYOKU_AI_USAGE_BIN_DIR="$BIN" "$BIN/ryoku-ai-usage"
	sleep "$_period"
done
