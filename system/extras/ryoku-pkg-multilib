#!/usr/bin/env bash
set -euo pipefail

[[ $(uname -m) == x86_64 ]] || {
  echo "ryoku-pkg-multilib: Fedora i686 packages require an x86_64 system" >&2
  exit 1
}
command -v dnf >/dev/null 2>&1 || {
  echo "ryoku-pkg-multilib: Fedora's dnf is required" >&2
  exit 1
}

# Fedora carries i686 packages in its normal repositories, with no extra stanza.
echo "multilib: Fedora supports i686 packages through the enabled DNF repositories"
