#!/usr/bin/env bash
set -euo pipefail

(($#)) || {
  echo "ryoku-pkg-remove: no packages given" >&2
  exit 2
}

command -v dnf >/dev/null 2>&1 || {
  echo "ryoku-pkg-remove: Fedora's dnf is required" >&2
  exit 1
}

# DNF can also remove dependents; let the user review the complete transaction.
priv=()
(( EUID == 0 )) || priv=(sudo)
exec "${priv[@]}" dnf --setopt=clean_requirements_on_remove=True remove -- "$@"
