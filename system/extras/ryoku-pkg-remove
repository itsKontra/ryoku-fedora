#!/usr/bin/env bash

# -Rs: drop the package plus deps nothing else needs. pacman won't remove a
# package another installed one still requires, so uninstalling an extras
# bundle won't break the rest of the system.

set -euo pipefail

(($#)) || {
  echo "ryoku-pkg-remove: no packages given" >&2
  exit 2
}

if command -v pacman >/dev/null 2>&1; then
  exec sudo pacman -Rs --noconfirm "$@"
elif command -v dnf >/dev/null 2>&1; then
  exec sudo dnf -y remove "$@"
elif command -v apt-get >/dev/null 2>&1; then
  exec sudo apt-get -y remove "$@"
else
  echo "ryoku-pkg-remove: no supported package manager found" >&2
  exit 1
fi
