#!/usr/bin/env bash
set -euo pipefail

(($#)) || {
  echo "ryoku-pkg-add: no packages given" >&2
  exit 2
}

command -v ryoku-host >/dev/null 2>&1 || {
  echo "ryoku-pkg-add: ryoku-host is required" >&2
  exit 1
}

priv=()
(( EUID == 0 )) || priv=(sudo)
exec "${priv[@]}" ryoku-host pkg install "$@"
