#!/usr/bin/env bash
set -euo pipefail

(($#)) || {
  echo "ryoku-pkg-add: no packages given" >&2
  exit 2
}

# The packaged path, never PATH: the install runs as root, and a checkout's
# ~/.local/bin copy is user-writable.
host=/usr/bin/ryoku-host
[[ -x $host ]] || {
  echo "ryoku-pkg-add: $host is required" >&2
  exit 1
}

priv=()
(( EUID == 0 )) || priv=(sudo)
exec "${priv[@]}" "$host" pkg install "$@"
