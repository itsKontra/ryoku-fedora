#!/usr/bin/bash
#
# kernel-install plugin: gives every kernel a "Ryoku console" boot entry, a twin
# of Fedora's BLS entry that boots to multi-user.target, so a text login is
# reachable from the GRUB menu when the desktop cannot start at all.
#
# Runs after 20-grub.install has written /boot/loader/entries/<id>-<kver>.conf
# and copies whatever that entry says, so the twin boots the same kernel,
# initramfs and options. The ~ in the name and version sorts it just below its
# kernel, as Fedora's own ~debug twins do, and GRUB's default is picked by entry
# id, so the twin never becomes the default.
#
#   add <kver> ...   twin that kernel's entry (kernel-install)
#   remove <kver>    drop the twin (kernel-install)
#   sync             twin every entry that lacks one and drop orphaned twins
#   purge            drop every twin (package removal)
set -u

bls_dir="${RYOKU_BLS_DIR:-/boot/loader/entries}"
suffix="~ryoku-console"

twin() {
  local entry="$1" out="${1%.conf}${suffix}.conf"
  # an entry without options would twin into a plain duplicate of the desktop
  grep -qs '^options[[:space:]]' "$entry" || return 0
  if ! awk -v sfx="$suffix" '
    /^title[ \t]/   { sub(/^title[ \t]+/, ""); print "title Ryoku console: " $0; next }
    /^version[ \t]/ { print $0 sfx; next }
    /^options[ \t]/ { print $0 " systemd.unit=multi-user.target"; next }
    { print }
  ' "$entry" >"$out.tmp"; then
    rm -f "$out.tmp"
    return 1
  fi
  mv -f "$out.tmp" "$out"
  if command -v restorecon >/dev/null 2>&1; then restorecon "$out" >/dev/null 2>&1; fi
  return 0
}

is_base() {
  case "${1##*/}" in
    *"$suffix".conf | *~debug.conf | *-0-rescue*.conf) return 1 ;;
  esac
}

mid="${KERNEL_INSTALL_MACHINE_ID:-$(cat /etc/machine-id 2>/dev/null)}"
kver="${2:-}"

case "${1:-}" in
  add)
    if [ -n "$mid" ] && [ -n "$kver" ]; then twin "$bls_dir/$mid-$kver.conf"; fi
    ;;
  remove)
    if [ -n "$mid" ] && [ -n "$kver" ]; then rm -f "$bls_dir/$mid-$kver$suffix.conf"; fi
    ;;
  sync)
    [ -d "$bls_dir" ] || exit 0
    for entry in "$bls_dir"/*.conf; do
      [ -f "$entry" ] || continue
      if is_base "$entry"; then
        twin "$entry"
      elif [[ $entry == *"$suffix".conf ]] && [ ! -f "${entry%"$suffix".conf}.conf" ]; then
        rm -f "$entry"
      fi
    done
    ;;
  purge)
    rm -f "$bls_dir"/*"$suffix".conf
    ;;
esac
exit 0
