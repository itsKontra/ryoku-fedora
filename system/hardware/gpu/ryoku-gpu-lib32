#!/usr/bin/env bash
# Install Fedora's i686 graphics userspace for 32-bit games and Proton.
# The NVIDIA libraries must match the installed driver branch.

set -euo pipefail

RYOKU_DRYRUN="${RYOKU_DRYRUN:-0}"
for arg in "$@"; do
  case "$arg" in
    --dry-run) RYOKU_DRYRUN=1 ;;
    -h | --help)
      echo "Usage: ryoku-gpu-lib32 [--dry-run]"
      echo "Install Fedora i686 GPU libraries for the detected hardware."
      exit 0
      ;;
    *)
      echo "ryoku-gpu-lib32: unknown argument: $arg" >&2
      exit 1
      ;;
  esac
done

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# gpu_field + the DRM_ROOT test seam come from the shared detector, the same
# one ryoku-gpu sources; no probing runs at source time (functions only).
# shellcheck source-path=SCRIPTDIR
# shellcheck source=ryoku-gpu-detect
source "$SCRIPT_DIR/ryoku-gpu-detect"

run() {
  if [[ $RYOKU_DRYRUN == 1 ]]; then
    printf 'DRYRUN: %s\n' "$*"
    return 0
  fi
  "$@"
}

# The loaded DRM driver of every real GPU, one per line. Reuses gpu_field and
# the DRM_ROOT seam from ryoku-gpu-detect, so it runs against a fake /sys tree
# in the tests exactly like the rest of the GPU tooling.
gpu_drivers() {
  local path base driver
  for path in "$DRM_ROOT"/card[0-9]*; do
    [[ -d $path && -e $path/device ]] || continue
    base="$(basename "$path")"
    [[ $base == *-* ]] && continue     # skip cardN-CONNECTOR subdevices
    driver="$(gpu_field "$path" DRIVER)"
    [[ -n $driver ]] && printf '%s\n' "$driver"
  done
}

main() {
  run ryoku-pkg-multilib

  local -a pkgs=(mesa-dri-drivers.i686 mesa-libGL.i686 vulkan-loader.i686)
  local driver nvidia_libs installed lib
  while read -r driver; do
    [[ -n $driver ]] || continue
    case "$driver" in
      amdgpu | radeon | i915 | xe | nouveau | virtio_gpu)
        pkgs+=(mesa-vulkan-drivers.i686)
        ;;
      nvidia)
        installed=$(rpm -qa --queryformat '%{NAME}.%{ARCH}\n')
        nvidia_libs=$(printf '%s\n' "$installed" \
          | sed -nE 's/^(xorg-x11-drv-nvidia(-[0-9]+xx)?-libs)\.x86_64$/\1.i686/p')
        [[ -n $nvidia_libs ]] || {
          echo "ryoku-gpu-lib32: no RPM Fusion NVIDIA libraries found; install the Fedora NVIDIA driver before its i686 libraries" >&2
          exit 1
        }
        while IFS= read -r lib; do pkgs+=("$lib"); done <<<"$nvidia_libs"
        ;;
    esac
  done < <(gpu_drivers)

  local -a want=()
  local p
  for p in "${pkgs[@]}"; do
    [[ " ${want[*]-} " == *" $p "* ]] || want+=("$p")
  done

  echo "ryoku-gpu-lib32: Fedora 32-bit GPU packages: ${want[*]}"
  run ryoku-pkg-add "${want[@]}"
}

main
