#!/usr/bin/env bash
# Report NetworkManager's configured backend and switch only to installed ones.
set -euo pipefail

CONF="${RYOKU_WIFI_BACKEND_CONF:-/etc/NetworkManager/conf.d/wifi-backend.conf}"

read_backend() {
  awk '
    /^[[:space:]]*\[/ { section = $0; gsub(/[[:space:]]/, "", section) }
    section == "[device]" && /^[[:space:]]*wifi\.backend[[:space:]]*=/ {
      sub(/^[^=]*=[[:space:]]*/, ""); sub(/[[:space:]#].*$/, ""); backend = $0
    }
    END { if (backend != "") print backend }
  '
}

current() {
  local backend="" config
  if [[ -n ${RYOKU_WIFI_BACKEND_CONF:-} ]]; then
    [[ ! -r $CONF ]] || backend=$(read_backend <"$CONF")
  elif config=$(NetworkManager --print-config 2>/dev/null); then
    backend=$(read_backend <<<"$config")
  elif [[ -r $CONF ]]; then
    backend=$(read_backend <"$CONF")
  fi
  echo "${backend:-wpa_supplicant}"
}

apply() {
  local backend=$1
  rpm -q "$backend" >/dev/null 2>&1 || {
    echo "ryoku-wifi-backend: install $backend with DNF before selecting it" >&2
    return 1
  }
  mkdir -p "$(dirname "$CONF")"
  cat >"$CONF" <<EOF
# Managed by ryoku-wifi-backend (Settings -> Connections).
[device]
wifi.backend=$backend
EOF
  if command -v restorecon >/dev/null 2>&1; then restorecon "$CONF"; fi
  if [[ $backend == wpa_supplicant ]]; then
    systemctl stop iwd.service 2>/dev/null || true
  else
    systemctl stop wpa_supplicant.service 2>/dev/null || true
  fi
  systemctl restart NetworkManager.service
}

case "${1:-get}" in
  get) current ;;
  iwd | wpa_supplicant) apply "$1" ;;
  *) echo "usage: ryoku-wifi-backend [get | iwd | wpa_supplicant]" >&2; exit 2 ;;
esac
