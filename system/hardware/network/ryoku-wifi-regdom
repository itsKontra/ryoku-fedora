#!/usr/bin/env bash
# Wi-Fi regulatory domain: pin the country so 5 GHz is actually usable.
#
# A non-self-managed wiphy boots on world domain 00, where most 5 GHz channels
# are disabled or no-IR (no initiating radiation). A dual-band SSID is then only
# ever seen on its 2.4 GHz BSS, which is the "can only connect to 2.4 GHz" bug.
# Nothing in Ryoku set a country, so this helper is the one place that does, and
# it persists the choice the two ways the stack reads it:
#
#   /etc/modprobe.d/ryoku-wireless-regdom.conf supplies cfg80211's country hint.
#   ryoku-wifi-regdom.service reapplies it at boot, including when cfg80211 was
#   already loaded by the initramfs. iwd configuration is updated only if iwd
#   is installed; Fedora normally uses wpa_supplicant.
#
# Privileged: it rewrites system config and calls `iw reg set`.
# 48-ryoku-wifi-regdom.rules grants exactly this binary to the wheel group
# without a password; `set` takes only a two-letter code it validates, so the
# grant is safe (same pattern as ryoku-wifi-backend). `get` and `status` are
# read-only and need no privilege.
#
#   get        print "<CC> <source>", source is configured | driver | unset
#   set <CC>   persist a two-letter country and apply it now
#   apply      idempotent install/upgrade/boot pass; never invents a country
#   status     one support line: effective domain + 5 GHz channels usable/blocked
set -euo pipefail

CONF="${RYOKU_REGDOM_CONF:-/etc/modprobe.d/ryoku-wireless-regdom.conf}"
IWD_CONF="${RYOKU_IWD_CONF:-/etc/iwd/main.conf}"

# Ryoku's default 5 GHz rank nudge for iwd, kept as one constant so `apply` only
# seeds it when the key is absent and never overwrites a hand-tuned value.
IWD_BAND_MODIFIER=1.3

conf_country() {
  [[ -r $CONF ]] || return 0
  sed -nE 's/^[[:space:]]*options[[:space:]]+cfg80211[[:space:]]+ieee80211_regdom=([A-Z]{2})[[:space:]]*$/\1/p' "$CONF" | head -n1
}

# the live kernel domain from `iw reg get`, empty when iw is absent.
driver_country() {
  command -v iw >/dev/null 2>&1 || return 0
  iw reg get 2>/dev/null \
    | awk '/^country [A-Z0-9][A-Z0-9]:/ { c = $2; sub(/:.*/, "", c); print c; exit }' || true
}

conf_write() {
  local content="options cfg80211 ieee80211_regdom=$1"
  if [[ ! -r $CONF ]] || [[ $(cat "$CONF") != "$content" ]]; then
    mkdir -p "$(dirname "$CONF")"
    printf '%s\n' "$content" >"$CONF"
    if command -v restorecon >/dev/null 2>&1; then restorecon "$CONF"; fi
  fi
}

iwd_installed() { rpm -q iwd >/dev/null 2>&1; }

# set key=value under [section] of an INI file, creating the file and section as
# needed and preserving every other key and section. mode=replace always sets
# the value; mode=absent writes it only when the key is missing. No-op writes are
# skipped so a repeat leaves the file untouched.
ini_set() {
  local file=$1 section=$2 key=$3 value=$4 mode=$5 tmp
  tmp=$(mktemp) || return 1
  if [[ ! -f $file ]]; then
    mkdir -p "$(dirname "$file")"
    : >"$file"
  fi
  awk -v section="$section" -v key="$key" -v value="$value" -v mode="$mode" '
    function emit() { print key "=" value; written = 1 }
    BEGIN { in_sec = 0; written = 0; seen_sec = 0; present = 0 }
    /^[[:space:]]*\[/ {
      if (in_sec && !written && !(mode == "absent" && present)) emit()
      hdr = $0
      sub(/^[[:space:]]*\[[[:space:]]*/, "", hdr)
      sub(/[[:space:]]*\].*$/, "", hdr)
      if (hdr == section) { in_sec = 1; seen_sec = 1; present = 0 } else in_sec = 0
      print; next
    }
    {
      if (in_sec && $0 ~ ("^[[:space:]]*" key "[[:space:]]*=")) {
        present = 1
        if (mode == "absent") { print; next }
        if (!written) { emit(); next }
        next
      }
      print
    }
    END {
      if (in_sec && !written && !(mode == "absent" && present)) emit()
      if (!seen_sec) {
        if (NR > 0) print ""
        print "[" section "]"
        emit()
      }
    }
  ' "$file" >"$tmp"
  cmp -s "$tmp" "$file" || cat "$tmp" >"$file"
  if command -v restorecon >/dev/null 2>&1; then restorecon "$file"; fi
  rm -f "$tmp"
}

regdom_get() {
  local cc
  cc=$(conf_country)
  if [[ -n $cc ]]; then
    printf '%s configured\n' "$cc"
    return 0
  fi
  cc=$(driver_country)
  if [[ -n $cc && $cc != 00 ]]; then
    printf '%s driver\n' "$cc"
    return 0
  fi
  printf '00 unset\n'
}

regdom_set() {
  local cc=${1:-}
  if [[ ! $cc =~ ^[A-Za-z]{2}$ ]]; then
    echo "usage: ryoku-wifi-regdom set <CC>  (two-letter ISO country code)" >&2
    exit 2
  fi
  cc=${cc^^}
  conf_write "$cc"
  if iwd_installed; then ini_set "$IWD_CONF" General Country "$cc" replace; fi
  if command -v iw >/dev/null 2>&1; then
    iw reg set "$cc" 2>/dev/null || true
  fi
  # iwd reads Country only at start, so a running iwd keeps the old hint until it
  # restarts. try-restart is a no-op when iwd is not running (a chroot, or NM on
  # wpa_supplicant), so it never disturbs a box that is not using iwd.
  # --no-ask-password: the helper is meant to run as root (pkexec, the package
  # hook, the installer chroot); a stray unprivileged run must fail fast instead
  # of blocking on an interactive polkit prompt.
  if command -v systemctl >/dev/null 2>&1; then
    systemctl --no-ask-password try-restart iwd.service >/dev/null 2>&1 || true
  fi
}

regdom_apply() {
  # 5 GHz rank nudge for iwd, seeded only when absent so a hand-tuned value wins.
  if iwd_installed; then ini_set "$IWD_CONF" Rank BandModifier5GHz "$IWD_BAND_MODIFIER" absent; fi
  # re-assert the persisted country when the live domain has drifted from it (a
  # boot before the udev rule ran, a driver that reset to 00). Never invent one:
  # with nothing configured there is nothing to apply, and no-wireless boxes exit 0.
  local cc
  cc=$(conf_country)
  [[ -n $cc ]] || return 0
  command -v iw >/dev/null 2>&1 || return 0
  [[ "$(driver_country)" == "$cc" ]] || iw reg set "$cc" 2>/dev/null || true
  return 0
}

regdom_status() {
  local cc src
  read -r cc src < <(regdom_get)
  if ! command -v iw >/dev/null 2>&1; then
    printf 'regdom %s (%s); 5 GHz channel status unavailable (iw not installed)\n' "$cc" "$src"
    return 0
  fi
  local usable blocked
  read -r usable blocked < <(iw phy 2>/dev/null | awk '
    {
      f = 0
      for (i = 2; i <= NF; i++) if ($i == "MHz") { f = $(i - 1) + 0; break }
      if (f >= 5000 && f < 5925) {
        if ($0 ~ /disabled/ || $0 ~ /no IR/) blocked++; else usable++
      }
    }
    END { printf "%d %d\n", usable + 0, blocked + 0 }')
  printf 'regdom %s (%s); 5 GHz channels: %s usable, %s blocked\n' "$cc" "$src" "$usable" "$blocked"
}

case "${1:-status}" in
  get)
    regdom_get
    ;;
  set)
    shift
    regdom_set "${1:-}"
    ;;
  apply)
    regdom_apply
    ;;
  status)
    regdom_status
    ;;
  *)
    echo "usage: ryoku-wifi-regdom [get | set <CC> | apply | status]" >&2
    exit 2
    ;;
esac
