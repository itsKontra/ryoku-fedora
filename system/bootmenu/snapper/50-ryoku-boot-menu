#!/usr/bin/sh
#
# snapper plugin (/usr/libexec/snapper/plugins/). snapperd runs it around
# every snapshot and config change with the event as its first argument. After
# a snapshot is created or deleted, the boot menu is resynced in the
# background, so building a kernel image for a new kernel never holds up the
# snapshot (or the `ryoku update` that took it).

case "${1:-}" in
  create-snapshot-post | delete-snapshot-post)
    systemctl start --no-block ryoku-snapshot-menu.service >/dev/null 2>&1 || :
    ;;
esac
exit 0
